#!/usr/bin/env python3

import os
import subprocess
import sys


COMMANDS = {
    "gpl": ["git", "pull"],
    "gps": ["git", "push"],
    "gst": ["git", "status"],
    "gco": ["git", "checkout"],
    "gcb": ["git", "checkout", "-b"],
    "gcm": ["git", "commit", "-m"],
    "gca": ["git", "commit", "--amend"],
    "gdf": ["git", "diff"],
    "gbr": ["git", "branch"],
    "gss": ["git", "stash"],
    "gsp": ["git", "stash", "pop"],
    "glg": ["git", "log", "--oneline", "--graph"],
}


def main() -> int:
    command = os.path.basename(sys.argv[0])

    if command not in COMMANDS:
        print(f"bm-git: unknown command: {command}", file=sys.stderr)
        return 1

    git_command = COMMANDS[command]
    args = sys.argv[1:]

    try:
        result = subprocess.run([*git_command, *args])
    except FileNotFoundError:
        print(
            "bm-git: git is not installed or not available in PATH",
            file=sys.stderr,
        )
        return 127
    except KeyboardInterrupt:
        return 130

    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
